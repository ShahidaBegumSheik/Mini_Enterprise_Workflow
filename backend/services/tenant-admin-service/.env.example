APP_NAME=MECWF Tenant Admin Service
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=mysql+pymysql://tenant_admin_db_user:tenant_admin_db_password@db:3306/tenant_admin_db

INTERNAL_API_KEY=change_me_shared_internal_api_key

JWT_SECRET_KEY=change_me_jwt_secret
JWT_ALGORITHM=HS256
JWT_ISSUER=mecwf-authentication-service
JWT_AUDIENCE=mecwf-services

ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=http://localhost:8000,http://localhost:8001,http://localhost:8003