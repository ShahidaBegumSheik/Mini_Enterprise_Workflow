# User Service configuration template.
#
# Copy to `.env` for local development, or let docker-compose inject the
# variables below from `backend/.env` when running the container.
#
# Never commit a filled-in copy of this file. `.env` is gitignored.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=User Service
APP_ENV=development
APP_VERSION=1.0.0

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The User Service owns its own database on the single shared MySQL server.
# `db` is the Docker Compose service name of that server; use `localhost` when
# running the service outside Docker.
#
# ${VAR} and ${VAR:-default} placeholders are expanded from the environment,
# so no host, password or secret has to be hardcoded in the image.
#
#   Docker:  mysql+pymysql://${USER_DB_USER}:${USER_DB_PASSWORD}@db:3306/user_db
#   Local:   mysql+pymysql://${USER_DB_USER}:${USER_DB_PASSWORD}@localhost:3307/user_db
DATABASE_URL=mysql+pymysql://${USER_DB_USER:-user_db_user}:${USER_DB_PASSWORD}@localhost:3307/user_db

# ---------------------------------------------------------------------------
# JWT verification (this service never issues tokens)
# ---------------------------------------------------------------------------
# Must match the Authentication Service so it can verify the tokens it issues.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# Optional hardening. Leave empty to keep accepting exactly what the
# Authentication Service issues today; set both to enforce registered claims.
JWT_ISSUER=
JWT_AUDIENCE=

# ---------------------------------------------------------------------------
# Internal service-to-service contract
# ---------------------------------------------------------------------------
# Shared credential sent by the Authentication Service as `X-Internal-API-Key`.
# When empty the internal router is disabled and answers 503.
INTERNAL_API_KEY=

# ---------------------------------------------------------------------------
# Listing / authorization
# ---------------------------------------------------------------------------
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
ADMIN_ROLES=admin,superadmin,super_admin,platform_admin
