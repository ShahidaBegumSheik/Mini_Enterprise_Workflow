# Application
APP_NAME=MECWF Authentication Service
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Port the app listens on inside its container and is published on the host.
# The Docker Compose service publishes ${AUTHENTICATION_SERVICE_PORT:-8001}.
AUTHENTICATION_SERVICE_PORT=8001

# This service's own database on the shared MySQL server. Uses the scoped
# auth_db user (see backend/db-init/init-databases.sh) -- the service only has
# credentials for its own schema and never touches user_db/tenant_admin_db.
DATABASE_URL=mysql+pymysql://auth_db_user:auth_db_password@db:3306/auth_db

# Shared internal API key used for service-to-service calls
INTERNAL_API_KEY=change_me_shared_internal_api_key

ENABLE_EXTERNAL_SERVICES=true
HTTP_TIMEOUT_SECONDS=15
HTTP_CONNECT_TIMEOUT_SECONDS=5

# JWT secret (also used to derive the Fernet key when OTP_ENCRYPTION_KEY is empty)
JWT_SECRET_KEY=change_me_long_random_jwt_secret
JWT_ALGORITHM=HS256
JWT_ISSUER=mecwf-authentication-service
JWT_AUDIENCE=mecwf-services

# OTP (short-lived, stateless; travels signed + encrypted inside the OTP flow cookie)
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
# Resend cap per flow. Both OTP_RESEND_LIMIT and OTP_MAX_RESENDS are accepted;
# the former is the canonical name.
OTP_RESEND_LIMIT=3

# Access / refresh session tokens
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Session cookies (HttpOnly; tokens never leave the cookies)
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token

# Password reset flow (reuses the OTP settings; separate cookies)
RESET_OTP_TOKEN_COOKIE_NAME=reset_otp_token
RESET_FLOW_TOKEN_COOKIE_NAME=reset_flow_token
RESET_VERIFIED_EXPIRE_MINUTES=10

# Fernet key used to encrypt the OTP payload. Must be a base64-urlsafe 32-byte
# key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# When empty it is derived from JWT_SECRET_KEY (development only).
OTP_ENCRYPTION_KEY=

# HTTP-only cookie carrying the OTP flow token
OTP_TOKEN_COOKIE_NAME=otp_token
# HTTP-only cookies carry every token (access, refresh, OTP/reset flow). The
# Secure flag is auto-enabled when APP_ENV=production; set COOKIE_SECURE to
# force it either way. SameSite and Path remain configurable.
# COOKIE_SECURE=
COOKIE_SAMESITE=lax
COOKIE_PATH=/
COOKIE_DOMAIN=

CORS_ORIGINS=http://localhost:8001,http://localhost:8002,http://localhost:8003

# Microservice base URLs (called through the shared HTTPX client).
# Inside Docker Compose these are the compose service names, never localhost.
# user-service and tenant-admin-service are the Compose names defined in the
# root /backend/docker-compose.yml; notification-service is owned by the
# Notification Service team (adds its container to the same file).
USER_SERVICE_URL=http://user-service:8002
TENANT_ADMIN_SERVICE_URL=http://tenant-admin-service:8003


# SMTP (legacy direct delivery for welcome messages only; OTPs go via the
# Notification Service)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=
EMAIL_FROM_NAME=MECWF Platform
DEVELOPER_REDIRECT_EMAIL=