# Application
APP_NAME=MECWF Authentication Service
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# This service's own database on the shared MySQL server
DATABASE_URL=mysql+pymysql://auth_db_user:auth_db_password@db:3306/auth_db

# Shared internal API key used for service-to-service calls
INTERNAL_API_KEY=change_me_shared_internal_api_key

ENABLE_EXTERNAL_SERVICES=true
HTTP_TIMEOUT_SECONDS=15
HTTP_CONNECT_TIMEOUT_SECONDS=5

# JWT secret (also used to derive the Fernet key when OTP_ENCRYPTION_KEY is empty)
JWT_SECRET_KEY=change_me_long_random_jwt_secret
JWT_ALGORITHM=HS256
JWT_ISSUER=mecwf-authentication-service
JWT_AUDIENCE=mecwf-services

# OTP (short-lived, stateless; travels signed + encrypted inside the OTP flow cookie)
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=3

# Fernet key used to encrypt the OTP payload. Must be a base64-urlsafe 32-byte
# key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# When empty it is derived from JWT_SECRET_KEY (development only).
OTP_ENCRYPTION_KEY=

# HTTP-only cookie carrying the OTP flow token
OTP_TOKEN_COOKIE_NAME=otp_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
COOKIE_PATH=/

CORS_ORIGINS=http://localhost:8001,http://localhost:8002,http://localhost:8003

# Microservice base URLs (called through the shared HTTPX client)
USER_SERVICE_URL=http://user-service:8002
TENANT_ADMIN_SERVICE_URL=http://tenant-admin-service:8003

# SMTP (email delivery for OTP / welcome messages)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=
EMAIL_FROM_NAME=MECWF Platform
DEVELOPER_REDIRECT_EMAIL=