# Application
APP_NAME=ECWF Tool
APP_VERSION=1.0.0
DEBUG=True

# Database
DATABASE_URL=url

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key
JWT_ALGORITHM=HS256

# Access Token
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh Token
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password hashing
BCRYPT_ROUNDS=12

# OTP
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Cookies
ACCESS_TOKEN_COOKIE=access_token
REFRESH_TOKEN_COOKIE=refresh_token
OTP_TOKEN_COOKIE=otp_token

COOKIE_HTTP_ONLY=True
COOKIE_SECURE=False
COOKIE_SAME_SITE=lax
COOKIE_PATH=/

# Notification Service
# Local development:
#   NOTIFICATION_SERVICE_URL=http://127.0.0.1:8004
# Docker (docker-compose.yml) sets:
#   NOTIFICATION_SERVICE_URL=http://notification-service:8000
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8004
INTERNAL_API_KEY=change-this-internal-key