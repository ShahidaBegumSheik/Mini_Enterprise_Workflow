# Shared runtime configuration
APP_ENV=development
LOG_LEVEL=INFO
ENABLE_EXTERNAL_SERVICES=true
HTTP_TIMEOUT_SECONDS=15
HTTP_CONNECT_TIMEOUT_SECONDS=5

# One shared MySQL server (db-init/init-databases.sh creates one database per
# service on it: auth_db, user_db, tenant_admin_db). Each database has its
# own dedicated user, scoped to only that database -- this is what actually
# enforces "exactly one owner service per table", not just convention. Each
# service's own .env uses its own credentials in its own DATABASE_URL.
MYSQL_ROOT_PASSWORD=root_password

AUTH_DB_USER=auth_db_user
AUTH_DB_PASSWORD=auth_db_password

USER_DB_USER=user_db_user
USER_DB_PASSWORD=user_db_password

TENANT_ADMIN_DB_USER=tenant_admin_db_user
TENANT_ADMIN_DB_PASSWORD=tenant_admin_db_password

# Shared service-to-service credential
INTERNAL_API_KEY=change_me_shared_internal_api_key